local function createToggle(text, default, callback)
    local row = new("Frame", {Size = UDim2.new(1, -20, 0, 38), Position = UDim2.new(0, 10, 0, 0), BackgroundColor3 = C.Panel, BorderSizePixel = 0, Parent = Main})
    corner(row, 8)
