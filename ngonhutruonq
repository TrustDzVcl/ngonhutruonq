local function sendWebhook(content)
    if not request or State.WebhookURL == "" then
        return false
    end
    local payload = {
        username = "TrustPremium",
        embeds = {{
            title = "TrustPremium | Anime CardVerse",
            description = content,
            color = 9127167,
            timestamp = DateTime.now():ToIsoDate(),
        }},
    }
    local ok = pcall(request, {
        Url = State.WebhookURL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload),
    })
    return ok
end

local function buildStatus()
    local lines = {"Player: " .. LocalPlayer.Name}
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        for _, v in ipairs(stats:GetChildren()) do
            if v:IsA("ValueBase") then
                table.insert(lines, v.Name .. ": " .. tostring(v.Value))
            end
        end
    end
    table.insert(lines, "Map: " .. tostring(LocalPlayer:GetAttribute("CurrentMap") or "Unknown"))
    return table.concat(lines, "\n")
end

task.spawn(function()
