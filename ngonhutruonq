local env = (getgenv and getgenv()) or _G
if env.TrustCleanup then pcall(env.TrustCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local CONFIG = {
    HeightOffset = 3,
    MaxRange = 400,
    SkillKeys = {
        Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
    },
    SkillInterval = 0.3,
    TargetRefresh = 0.2,
    DodgeDistance = 30,
    DodgeHeight = 15
}

local State = {
    AutoFarm = false,
    AutoSkill = true,
    Dodge = true,
    TargetMode = "Tất cả",
}

local TargetModes = {"Tất cả", "Boss", "Alien Soldier", "Alien Officer", "Alien Scout", "Frieza", "Captain Shinyu"}
local currentModeIndex = 1
local NPC_BLACKLIST = {"menu", "npc", "shop", "quest", "seller", "trainer", "dummy", "spawn"}
local Connections = {}
local alive = true
local currentTarget = nil
local isDodging = false

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

-- Hàm bấm phím hỗ trợ cả PC và Mobile (Giả lập)
local function pressSkill(key)
    if keypress then
        pcall(keypress, 0.05) -- Dành cho executor Mobile
    else
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end
end

local function isNPC(obj)
    local nameLower = string.lower(obj.Name)
    for _, black in ipairs(NPC_BLACKLIST) do
        if string.find(nameLower, black, 1, true) then return true end
    end
    return false
end

local MouseUtil
pcall(function()
    local utils = ReplicatedStorage:FindFirstChild("Utilities")
    if utils then
        MouseUtil = require(utils:WaitForChild("MouseUtil", 5))
    end
end)

local originalGetTarget
if type(MouseUtil) == "table" and type(MouseUtil.GetTarget) == "function" then
    originalGetTarget = MouseUtil.GetTarget
    MouseUtil.GetTarget = function(...)
        if State.AutoFarm and currentTarget and currentTarget.Parent then
            return currentTarget.Position
        end
        return originalGetTarget(...)
    end
end

local function getClosestEnemy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, bestDist = nil, CONFIG.MaxRange
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            
            if hum and hum.Health > 0 and eRoot and not isNPC(obj) then
                local baseName = obj.Name:gsub("_%d+$", "")
                local isTargeted = false
                
                if State.TargetMode == "Tất cả" then isTargeted = true
                elseif State.TargetMode == "Boss" then
                    if baseName == "Frieza" or baseName == "Captain Shinyu" then isTargeted = true end
                elseif baseName == State.TargetMode then isTargeted = true end

                if isTargeted then
                    local d = (root.Position - eRoot.Position).Magnitude
                    if d < bestDist then best, bestDist = eRoot, d end
                end
            end
        end
    end
    return best
end

-- Vòng lặp tìm quái
task.spawn(function()
    while alive do
        if State.AutoFarm then
            currentTarget = getClosestEnemy()
        else
            currentTarget = nil
        end
        task.wait(CONFIG.TargetRefresh)
    end
end)

-- Vòng lặp Né Chiêu (Đã fix lỗi quét nhầm địa hình)
task.spawn(function()
    while alive do
        if State.AutoFarm and State.Dodge and not isDodging and currentTarget and currentTarget.Parent then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if root then
                local dangerDetected = false
                
                -- Chỉ quét Hitbox nếu nó nằm trong 25 studs
                local partsAround = workspace:GetPartBoundsInRadius(root.Position, 25)
                for _, part in ipairs(partsAround) do
                    local pName = string.lower(part.Name)
                    if string.find(pName, "hitbox") or string.find(pName, "warning") then
                        dangerDetected = true
                        break
                    end
                end

                if dangerDetected then
                    isDodging = true
                    local direction = (root.Position - currentTarget.Position).Unit
                    local dodgePos = root.Position + (direction * CONFIG.DodgeDistance) + Vector3.new(0, CONFIG.DodgeHeight, 0)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = CFrame.new(dodgePos, currentTarget.Position)
                    task.wait(0.5) 
                    isDodging = false
                end
            end
        end
        task.wait(0.1)
    end
end)

-- Vòng lặp dí quái (Heartbeat)
track(RunService.Heartbeat:Connect(function()
    if not (alive and State.AutoFarm) or isDodging then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local target = currentTarget
    if root and target and target.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        local targetPos = target.Position
        local myPos = targetPos + Vector3.new(0, CONFIG.HeightOffset, 0)
        root.CFrame = CFrame.new(myPos, targetPos) * CFrame.new(0, 0, 2)
    end
end))

-- Vòng lặp bấm Skill
task.spawn(function()
    while alive do
        if State.AutoFarm and State.AutoSkill and not isDodging and currentTarget and currentTarget.Parent then
            for _, key in ipairs(CONFIG.SkillKeys) do
                if not (alive and State.AutoFarm and State.AutoSkill) or isDodging then break end
                pressSkill(key)
                task.wait(0.05)
            end
        end
        task.wait(CONFIG.SkillInterval)
    end
end)

