statusLbl.Size = UDim2.fromOffset(300, 40)
statusLbl.Position = UDim2.new(0.5, -150, 0, 142)
statusLbl.BackgroundTransparency = 1
statusLbl.TextColor3 = Color3.fromRGB(255, 200, 50)
statusLbl.Font = Enum.Font.SourceSansBold
statusLbl.TextSize = 14
statusLbl.TextWrap = true
statusLbl.Text = "Trạng thái: Chờ lệnh..."
