local function createTab(name)
    local btn = new("TextButton", {Size = UDim2.new(0, 70, 1, 0), BackgroundColor3 = Color3.fromRGB(28, 28, 35), Text = name, TextColor3 = Color3.fromRGB(150, 150, 165), Font = Enum.Font.GothamBold, TextSize = 12, BorderSizePixel = 0, Parent = TabBar})
    corner(btn, 6)
    local page = new("ScrollingFrame", {Size = UDim2.new(1, -20, 1, -88), Position = UDim2.fromOffset(10, 80), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = Main})
    new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
    
    local function activate()
        for _, p in ipairs(Pages) do p.Page.Visible = false p.Btn.TextColor3 = Color3.fromRGB(150, 150, 165) p.Btn.BackgroundColor3 = Color3.fromRGB(28, 28, 35) end
        page.Visible = true btn.TextColor3 = Color3.new(1,1,1) btn.BackgroundColor3 = Color3.fromRGB(130, 90, 255)
    end
    btn.MouseButton1Click:Connect(activate)
    table.insert(Pages, {Btn = btn, Page = page})
    if #Pages == 1 then activate() end
    return page
end

local function createToggle(parent, text, default, callback)
    local row = new("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Color3.fromRGB(28, 28, 35), BorderSizePixel = 0, Parent = parent})
    corner(row, 8)
    new("TextLabel", {Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row})
    local switch = new("Frame", {Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -56, 0.5, -11), BackgroundColor3 = default and Color3.fromRGB(130, 90, 255) or Color3.fromRGB(60, 60, 70), BorderSizePixel = 0, Parent = row})
    corner(switch, 11)
    local knob = new("Frame", {Size = UDim2.fromOffset(18, 18), Position = default and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Parent = switch})
    corner(knob, 9)
    local click = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = row})
    local state = default
    click.MouseButton1Click:Connect(function()
        state = not state
        switch.BackgroundColor3 = state and Color3.fromRGB(130, 90, 255) or Color3.fromRGB(60, 60, 70)
        knob.Position = state and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2)
        if callback then callback(state) end
    end)
end

local function createStepper(parent, text, default, min, max, step, callback)
    local value = default
    local row = new("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Color3.fromRGB(28, 28, 35), BorderSizePixel = 0, Parent = parent})
    corner(row, 8)
    new("TextLabel", {Size = UDim2.new(1, -120, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row})
    local minus = new("TextButton", {Size = UDim2.fromOffset(28, 26), Position = UDim2.new(1, -100, 0.5, -13), BackgroundColor3 = Color3.fromRGB(60, 60, 70), Text = "-", TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, Parent = row})
    local valLbl = new("TextLabel", {Size = UDim2.fromOffset(44, 26), Position = UDim2.new(1, -72, 0.5, -13), BackgroundTransparency = 1, Text = tostring(value), TextColor3 = Color3.fromRGB(130, 90, 255), Font = Enum.Font.GothamBold, TextSize = 13, Parent = row})
    local plus = new("TextButton", {Size = UDim2.fromOffset(28, 26), Position = UDim2.new(1, -30, 0.5, -13), BackgroundColor3 = Color3.fromRGB(60, 60, 70), Text = "+", TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, Parent = row})
    corner(minus, 6) corner(plus, 6)
    local function apply(v)
        value = math.clamp(v, min, max)
        valLbl.Text = tostring(value)
        if callback then callback(value) end
    end
    minus.MouseButton1Click:Connect(function() apply(value - step) end)
    plus.MouseButton1Click:Connect(function() apply(value + step) end)
end

