dumpBtn.Parent = frame
Instance.new("UICorner", dumpBtn).CornerRadius = UDim.new(0, 6)

local function dumpUI()
    local lines = {}
    local bar = findBar()
    if bar then
        local root = (bar.Parent and bar.Parent.Parent) or bar.Parent or bar
        local function walk(o, depth)
            if #lines > 150 or depth > 6 then
                return
            end
            local s = string.rep(" ", depth) .. o.ClassName .. " " .. o.Name
            if o:IsA("GuiObject") then
                s = s .. string.format(" vis=%s pos=%.0f,%.0f size=%.0f,%.0f",
                    tostring(o.Visible), o.AbsolutePosition.X, o.AbsolutePosition.Y,
                    o.AbsoluteSize.X, o.AbsoluteSize.Y)
                if o:IsA("Frame") then
                    local c = o.BackgroundColor3
                    s = s .. string.format(" bg=%d,%d,%d", c.R * 255, c.G * 255, c.B * 255)
                end
            end
            if o:IsA("UIGradient") then
                local t = {}
                for _, kp in ipairs(o.Color.Keypoints) do
                    t[#t + 1] = string.format("%.2f:%d,%d,%d", kp.Time,
                        kp.Value.R * 255, kp.Value.G * 255, kp.Value.B * 255)
                end
                s = s .. " grad=" .. table.concat(t, ";")
                    .. " off=" .. tostring(o.Offset.X) .. " rot=" .. tostring(o.Rotation)
            end
            lines[#lines + 1] = s
            for _, c in ipairs(o:GetChildren()) do
                walk(c, depth + 1)
            end
        end
        walk(root, 0)
    else
        lines[1] = "Chua thay thanh. ScreenGui trong PlayerGui:"
        for _, g in ipairs(PlayerGui:GetChildren()) do
            lines[#lines + 1] = g.ClassName .. " " .. g.Name
                .. (g:IsA("ScreenGui") and (" enabled=" .. tostring(g.Enabled)) or "")
        end
    end
    local text = table.concat(lines, "\n")
    if setclipboard then
        pcall(setclipboard, text)
        dumpBtn.Text = "Đã copy! Dán vào chat"
    else
        print(text)
        dumpBtn.Text = "Executor không có clipboard (xem F9)"
    end
    task.delay(3, function()
        if dumpBtn and dumpBtn.Parent then
            dumpBtn.Text = "Copy cấu trúc thanh (gửi cho mình)"
        end
    end)
end
track(dumpBtn.MouseButton1Click:Connect(dumpUI))

-- Kéo menu
local dragging, dragStart, startPos = false, nil, nil
track(title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end))
track(UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end))