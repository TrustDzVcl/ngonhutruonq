local env = (getgenv and getgenv()) or _G
if env.TrustPremiumCleanup then pcall(env.TrustPremiumCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local CONFIG = {
    HeightOffset = 7,
    MaxRange = 1000,
    SkillRange = 15,
    SkillKeys = {
        Enum.KeyCode.One,
        Enum.KeyCode.Two,
        Enum.KeyCode.Three,
        Enum.KeyCode.Four,
        Enum.KeyCode.Five,
    },
    SkillInterval = 0.25,
    KeyHold = 0.05,
    TargetRefresh = 0.2,
}

local State = {
    AutoFarm = false,
    AutoSkill = true,
}

local Connections = {}
local alive = true
local currentTarget = nil

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local MouseUtil
pcall(function()
    local utils = ReplicatedStorage:WaitForChild("Utilities", 10)
    MouseUtil = require(utils:WaitForChild("MouseUtil", 10))
end)

local originalGetTarget
if type(MouseUtil) == "table" and type(MouseUtil.GetTarget) == "function" then
    originalGetTarget = MouseUtil.GetTarget
    MouseUtil.GetTarget = function(...)
        if State.AutoFarm and currentTarget and currentTarget.Parent then
            return currentTarget.Position
        end
        return originalGetTarget(...)
    end
end

local function getClosestEnemy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    local best, bestDist = nil, CONFIG.MaxRange
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            
            local isSummon = false
            
            local owner = obj:FindFirstChild("Owner") or obj:FindFirstChild("Creator") or obj:FindFirstChild("Master") or obj:FindFirstChild("Player")
            if owner and owner:IsA("ObjectValue") and owner.Value then
                if owner.Value:IsA("Player") or owner.Value:IsA("Model") then
                    isSummon = true
                end
            end
            
            local ownerAttr = obj:GetAttribute("Owner") or obj:GetAttribute("OwnerUserId") or obj:GetAttribute("Creator")
            if ownerAttr then
                isSummon = true
            end
            
            local nameLower = string.lower(obj.Name)
            if nameLower:find("pet") or nameLower:find("summon") or nameLower:find("clone") or nameLower:find("minion") then
                isSummon = true
            end
            
            if hum and hum.Health > 0 and eRoot and not isSummon then
                local d = (root.Position - eRoot.Position).Magnitude
                if d < bestDist then
                    best, bestDist = eRoot, d
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while alive do
        if State.AutoFarm then
            currentTarget = getClosestEnemy()
        else
            currentTarget = nil
        end
        task.wait(CONFIG.TargetRefresh)
    end
end)

track(RunService.Stepped:Connect(function()
    if not (alive and State.AutoFarm) then
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local target = currentTarget
    
    if root and target and target.Parent then
        local currentPos = root.Position
        local targetX = target.Position.X
        local targetZ = target.Position.Z
        local targetY = target.Position.Y + CONFIG.HeightOffset
        
        local smoothPos = currentPos:Lerp(Vector3.new(targetX, targetY, targetZ), 0.25)
        local lookAt = Vector3.new(targetX, smoothPos.Y, targetZ)
        
        root.CFrame = CFrame.new(smoothPos, lookAt)
    end
end))

task.spawn(function()
    while alive do
        if State.AutoFarm and State.AutoSkill and currentTarget and currentTarget.Parent then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if root then
                local distance = (root.Position - currentTarget.Position).Magnitude
                
                if distance <= CONFIG.SkillRange then
                    for _, key in ipairs(CONFIG.SkillKeys) do
                        if not (alive and State.AutoFarm and State.AutoSkill) then
                            break
                        end
                        VirtualInputManager:SendKeyEvent(true, key, false, game)
                        task.wait(CONFIG.KeyHold)
                        VirtualInputManager:SendKeyEvent(false, key, false, game)
                        task.wait(0.05)
                    end
                end
            end
        end
        task.wait(CONFIG.SkillInterval)
    end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "TrustPremium"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
