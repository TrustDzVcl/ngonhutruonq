local order = 0
local function nextOrder() order += 1 return order end
local function track(conn) table.insert(Connections, conn) return conn end

local function new(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do
        pcall(function() inst[k] = v end)
    end
    inst.Parent = parent
    return inst
end

local function corner(obj, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius), Parent = obj})
end

local function addStroke(obj, color, thickness)
    return new("UIStroke", {
        Color = color or C.Accent,
        Thickness = thickness or 1.5,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = obj
    })
end

local function protectGui(gui)
    local ok = false
    if gethui then ok = pcall(function() gui.Parent = gethui() end) end
    if not ok or not gui.Parent then
        ok = pcall(function() gui.Parent = CoreGui end)
        if not ok or not gui.Parent then gui.Parent = PlayerGui end
    end
end

local function GetClosestEnemy()
    local currentMap = LocalPlayer:GetAttribute("CurrentMap")
    if currentMap == "Lobby" or not currentMap then return nil end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closestEnemy = nil
    local shortestDistance = math.huge
    local rootPos = root.Position

    local children = workspace:GetChildren()
    for i = 1, #children do
        local obj = children[i]
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and enemyRoot then
                local d = (rootPos - enemyRoot.Position).Magnitude
                if d < shortestDistance and d < 400 then
                    shortestDistance = d
                    closestEnemy = enemyRoot
                end
            end
        end
    end

    if not closestEnemy then
        local desc = workspace:GetDescendants()
        for i = 1, #desc do
            local obj = desc[i]
            if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hum and hum.Health > 0 and enemyRoot then
                    local d = (rootPos - enemyRoot.Position).Magnitude
                    if d < shortestDistance and d < 400 then
                        shortestDistance = d
                        closestEnemy = enemyRoot
                    end
                end
            end
        end
    end

    return closestEnemy
end

local function startFarm()
    if Running.farm then return end
    Running.farm = true

    task.spawn(function()
        RunService.Heartbeat:Connect(function()
            if not State.AutoFarm or not Running.farm then return end
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local target = GetClosestEnemy()
            if root and target then
                root.Velocity = Vector3.new(0, 0, 0)
                local targetPos = target.Position + Vector3.new(0, State.HeightOffset, 0)
                root.CFrame = CFrame.new(targetPos, target.Position)
            end
        end)
    end)

    task.spawn(function()
        while State.AutoFarm and Running.farm do
            task.wait(State.SkillDelay)
            local target = GetClosestEnemy()
            if State.AutoFarm and target then
                pcall(function()
                    RemoteBank.PunchRemote:Fire()
                    RemoteBank.CastPower:Fire({
                        targetPosition = target.Position
                    })
                end)
            end
        end
        Running.farm = false
    end)
end

local function stopFarm()
    State.AutoFarm = false
    Running.farm = false
end

local function makeDraggable(handle, target, onClick)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if endedConn then endedConn:Disconnect() end
                    if not moved and onClick then task.spawn(onClick) end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end))
end

local function createRow(parent, height)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, height or 38),
        BackgroundColor3 = C.Panel,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
    corner(row, 8)
    addStroke(row, Color3.fromRGB(50, 50, 65), 1)
    return row
end

local function createSection(parent, text)
    return new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Text = string.upper(text),
        TextColor3 = C.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
end

local function createToggle(parent, text, default, callback)
    local row = createRow(parent)
    new("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local switchBg = new("Frame", {
        Size = UDim2.fromOffset(44, 22),
        Position = UDim2.new(1, -56, 0.5, -11),
        BackgroundColor3 = default and C.Accent or C.Off,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(switchBg, 11)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = default and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = switchBg,
    })
    corner(knob, 9)
    local clickBtn = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })
    local state = default
    local function set(v)
        state = v
        TweenService:Create(switchBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { BackgroundColor3 = v and C.Accent or C.Off }):Play()
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Position = v and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2) }):Play()
        if callback then task.spawn(callback, v) end
    end
    track(clickBtn.MouseButton1Click:Connect(function() set(not state) end))
    return set
end

local function createStepper(parent, text, default, min, max, step, callback)
    local value = default
    step = step or 1
    local row = createRow(parent)
    new("TextLabel", {
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local minus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -100, 0.5, -13),
        BackgroundColor3 = C.Off, Text = "-", TextColor3 = C.Text,
        Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, Parent = row,
    })
    corner(minus, 6)
    
    local valueLbl = new("TextLabel", {
        Size = UDim2.fromOffset(44, 26),
        Position = UDim2.new(1, -72, 0.5, -13),
        BackgroundTransparency = 1, Text = tostring(value),
        TextColor3 = C.Accent, Font = Enum.Font.GothamBold, TextSize = 13, Parent = row,
    })
    
    local plus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -30, 0.5, -13),
        BackgroundColor3 = C.Off, Text = "+", TextColor3 = C.Text,
        Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, Parent = row,
    })
    corner(plus, 6)

    local function fmt(n)
        if n == math.floor(n) then return tostring(math.floor(n)) end
        return string.format("%.2f", n)
    end
    local function apply(v)
        value = math.clamp(v, min, max)
        valueLbl.Text = fmt(value)
        if callback then task.spawn(callback, value) end
    end
    track(minus.MouseButton1Click:Connect(function() apply(value - step) end))
    track(plus.MouseButton1Click:Connect(function() apply(value + step) end))
end

local function createTab(name)
    local tabBar = ScreenGui.Main:FindFirstChild("TabBar")
    local btn = new("TextButton", {
        Size = UDim2.new(0, 85, 1, 0), BackgroundColor3 = C.Panel, Text = name,
        TextColor3 = C.Sub, Font = Enum.Font.GothamBold, TextSize = 12, BorderSizePixel = 0, Parent = tabBar,
    })
    corner(btn, 6)
    
    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -88), Position = UDim2.fromOffset(10, 80), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, Parent = ScreenGui.Main,
    })
    new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
    
    local function activate()
        for _, p in ipairs(Pages) do
            p.Page.Visible = false
            p.Btn.TextColor3 = C.Sub
            p.Btn.BackgroundColor3 = C.Panel
        end
        page.Visible = true
        btn.TextColor3 = C.Text
        btn.BackgroundColor3 = C.Accent
    end
    track(btn.MouseButton1Click:Connect(activate))
    table.insert(Pages, {Btn = btn, Page = page})
    if #Pages == 1 then activate() end
    return page
end

