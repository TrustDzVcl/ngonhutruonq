local order = 0
local function nextOrder()
    order += 1
    return order
end

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local function new(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do
        pcall(function() inst[k] = v end)
    end
    inst.Parent = parent
    return inst
end

local function corner(obj, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius), Parent = obj})
end

local function protectGui(gui)
    local ok = false
    if gethui then
        ok = pcall(function() gui.Parent = gethui() end)
    end
    if not ok or not gui.Parent then
        ok = pcall(function() gui.Parent = CoreGui end)
        if not ok or not gui.Parent then
            gui.Parent = PlayerGui
        end
    end
end

local function getMapFolder()
    for _, name in ipairs(MAP_FOLDER_NAMES) do
        local folder = workspace:FindFirstChild(name)
        if folder and #folder:GetChildren() > 0 then
            return folder
        end
    end
    return nil
end

local function refreshMaps()
    local list = {}
    local folder = getMapFolder()
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") or child:IsA("Folder") then
                table.insert(list, child.Name)
            end
        end
    end
    table.sort(list)
    if State.SelectedMap and not table.find(list, State.SelectedMap) then
        State.SelectedMap = nil
    end
    return list
end

local function getSearchRoot()
    if not State.SelectedMap then
        return workspace
    end
    local folder = getMapFolder()
    return folder and folder:FindFirstChild(State.SelectedMap) or nil
end

local _targetCache = nil
local _targetCacheTime = 0
local TARGET_CACHE_DURATION = 0.2

local function findTarget(hrp)
    local now = tick()
    if _targetCache and _targetCache.Parent and (now - _targetCacheTime) < TARGET_CACHE_DURATION then
        local root = _targetCache:FindFirstChild("HumanoidRootPart")
        if root then
            return root
        end
    end

    local searchRoot = getSearchRoot()
    if not searchRoot then return nil end

    local localChar = LocalPlayer.Character
    local best, bestDist = nil, math.huge
    local hrpPos = hrp.Position

    local children = searchRoot:GetChildren()
    for i = 1, #children do
        local model = children[i]
        if model:IsA("Model") and model ~= localChar 
           and not Players:GetPlayerFromCharacter(model) then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root then
                    local dx = root.Position.X - hrpPos.X
                    local dy = root.Position.Y - hrpPos.Y
                    local dz = root.Position.Z - hrpPos.Z
                    local d = dx*dx + dy*dy + dz*dz
                    if d < bestDist then
                        best, bestDist = root, d
                    end
                end
            end
        end
    end

    if not best then
        local desc = searchRoot:GetDescendants()
        for i = 1, #desc do
            local obj = desc[i]
            if obj:IsA("Humanoid") and obj.Health > 0 then
                local model = obj.Parent
                if model and model:IsA("Model")
                    and model ~= localChar
                    and not Players:GetPlayerFromCharacter(model) then
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dx = root.Position.X - hrpPos.X
                        local dy = root.Position.Y - hrpPos.Y
                        local dz = root.Position.Z - hrpPos.Z
                        local d = dx*dx + dy*dy + dz*dz
                        if d < bestDist then
                            best, bestDist = root, d
                        end
                    end
                end
            end
        end
    end

    if best then
        _targetCache = best.Parent
        _targetCacheTime = now
    end

    return best
end

local _equippedTool = nil
local function ensureTool(char, hum)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        _equippedTool = tool
        return tool
    end
    if _equippedTool and _equippedTool.Parent then
        return _equippedTool
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    tool = backpack and backpack:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() hum:EquipTool(tool) end)
        _equippedTool = tool
    end
    return tool
end

local _lastCFrame = nil
local function smoothTeleport(hrp, targetPos, dist)
    local desired = CFrame.lookAt(targetPos + Vector3.new(0, dist, 0), targetPos)
    if _lastCFrame and (_lastCFrame.Position - desired.Position).Magnitude < 0.1 then
        return
    end
    _lastCFrame = desired
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = desired
end

local function spamSkills(char)
    if not State.SpamSkill then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end

    local skills = char:FindFirstChild("Skills")
    if skills then
        for _, skill in ipairs(skills:GetChildren()) do
            if skill:IsA("RemoteEvent") or skill:IsA("RemoteFunction") then
                pcall(function()
                    if skill:IsA("RemoteEvent") then
                        skill:FireServer()
                    else
                        skill:InvokeServer()
                    end
                end)
            end
        end
    end

    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("RemoteEvent") then
            pcall(function() v:FireServer() end)
        end
    end
end

local function startFarm()
    if Running.farm then return end
    Running.farm = true

    task.spawn(function()
        local skillAccum = 0
        while State.AutoFarm and Running.farm do
            local dt = RunService.Heartbeat:Wait()

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 then
                local targetRoot = findTarget(hrp)

                if targetRoot and targetRoot.Parent then
                    local tool = ensureTool(char, hum)
                    smoothTeleport(hrp, targetRoot.Position, State.Distance)

                    if tool then
                        pcall(function() tool:Activate() end)
                    end

                    if State.SpamSkill then
                        skillAccum += dt
                        if skillAccum >= State.SkillDelay then
                            skillAccum = 0
                            spamSkills(char)
                        end
                    end
                end
            end

            task.wait(State.AttackDelay)
        end
        Running.farm = false
        _equippedTool = nil
        _targetCache = nil
        _lastCFrame = nil
    end)
end

local function makeDraggable(handle, target, onClick)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if endedConn then endedConn:Disconnect() end
                    if not moved and onClick then
                        task.spawn(onClick)
                    end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))
end

