local gui, statusLabel, toggleBtn

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local function isGreen(c)
    return c.G > 0.45 and (c.G - c.R) > 0.15 and (c.G - c.B) > 0.15
end

--========== TÌM THANH (vùng xanh nằm trong UIGradient) ==========
local barCache, gradCache, markerCache = nil, nil, nil

local function validCache()
    return barCache and barCache.Parent and barCache.Visible
        and gradCache and gradCache.Parent
        and markerCache and markerCache.Parent and markerCache.Visible
end

local function gradientHasGreen(grad)
    for _, kp in ipairs(grad.Color.Keypoints) do
        if isGreen(kp.Value) then
            return true
        end
    end
    return false
end

local function findBar()
    if validCache() then
        return barCache, gradCache, markerCache
    end
    barCache, gradCache, markerCache = nil, nil, nil

    for _, bar in ipairs(PlayerGui:GetDescendants()) do
        if bar:IsA("GuiObject") and bar.Visible
            and bar.AbsoluteSize.X > 120
            and bar.AbsoluteSize.Y >= 6 and bar.AbsoluteSize.Y <= 80 then
            local grad = bar:FindFirstChildOfClass("UIGradient")
            if grad and gradientHasGreen(grad) then
                local bw = bar.AbsoluteSize.X
                local bt = bar.AbsolutePosition.Y
                local bh = bar.AbsoluteSize.Y
                local root = bar.Parent or bar
                local marker
                for _, c in ipairs(root:GetDescendants()) do
                    if c ~= bar and c:IsA("GuiObject") and c.Visible
                        and c.AbsoluteSize.X >= 2
                        and c.AbsoluteSize.X <= bw * 0.06
                        and c.AbsoluteSize.Y >= bh * 0.5 then
                        local cy = c.AbsolutePosition.Y + c.AbsoluteSize.Y / 2
                        if cy >= bt - 15 and cy <= bt + bh + 15 then
                            marker = c
                            break
                        end
                    end
                end
                if marker then
                    barCache, gradCache, markerCache = bar, grad, marker
                    return bar, grad, marker
                end
            end
        end
    end
    return nil
end

-- Tính vùng xanh (0..1) từ UIGradient, tính lại mỗi khung hình
local function greenRange(grad)
    local lo, hi
    for _, kp in ipairs(grad.Color.Keypoints) do
        if isGreen(kp.Value) then
            lo = lo and math.min(lo, kp.Time) or kp.Time
            hi = hi and math.max(hi, kp.Time) or kp.Time
        end
    end
    if not lo then
        return 0.4, 0.6
    end
    if hi - lo < 0.04 then
        lo, hi = lo - 0.04, hi + 0.04
    end
    local off = grad.Offset.X
    return lo + off, hi + off
end

--========== ĐIỀU KHIỂN ==========
local function setHold(on)
    if State.Holding == on then
        return
    end
    State.Holding = on
    pcall(function()
        local m = UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(m.X, m.Y, 0, on, game, 0)
    end)
    -- Điện thoại: giả lập thêm một ngón chạm giữ ở giữa-trái màn hình
    if UIS.TouchEnabled then
        pcall(function()
            local vs = workspace.CurrentCamera.ViewportSize
            VIM:SendTouchEvent(1, on and 0 or 2, vs.X * 0.3, vs.Y * 0.5)
        end)
    end
end

local function setStatus(text)
    if State.Status ~= text then
        State.Status = text
        if statusLabel then
            statusLabel.Text = text
        end
    end
end

local function refreshToggle()
    if not toggleBtn then
        return
    end
    toggleBtn.Text = State.Enabled and "ĐANG BẬT (bấm để tắt)" or "ĐANG TẮT (bấm để bật)"
    toggleBtn.BackgroundColor3 = State.Enabled and Color3.fromRGB(50, 200, 90) or Color3.fromRGB(200, 60, 80)
end

track(RunService.RenderStepped:Connect(function()
    if not alive then
        return
    end
    if not State.Enabled then
        setHold(false)
        setStatus("Trạng thái: tắt")
        return
    end

    local ok, err = pcall(function()
        local bar, grad, marker = findBar()
        if not bar then
            setHold(false)
            State.LastX = nil
            setStatus("Trạng thái: chưa thấy thanh")
            return
        end
        local t0, t1 = greenRange(grad)
        local bl = bar.AbsolutePosition.X
        local bw = bar.AbsoluteSize.X
        local zl = bl + bw * t0
        local zw = bw * (t1 - t0)
        local center = zl + zw / 2
        local mx = marker.AbsolutePosition.X + marker.AbsoluteSize.X / 2

        if State.LastX and State.Holding then
            local dx = mx - State.LastX
            if math.abs(dx) > 0.3 then
                State.HoldDir = dx > 0 and 1 or -1
            end
        end
        State.LastX = mx

        local diff = center - mx
        local deadband = zw * 0.08
        if math.abs(diff) <= deadband then
            setHold(false)
        else
            local needDir = diff > 0 and 1 or -1
            setHold(needDir == State.HoldDir)
        end
        setStatus(string.format("Thanh: kim %.0f | xanh %.0f-%.0f | %s",
            mx, zl, zl + zw, State.Holding and "GIỮ" or "nhả"))
    end)
    if not ok then
        setHold(false)
        setStatus("Lỗi: " .. tostring(err):sub(1, 40))
    end
end))

--========== XÓA SCRIPT ==========
local function cleanup()
    alive = false
    State.Enabled = false
    setHold(false)
    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)
    if gui then
        pcall(function()
            gui:Destroy()
        end)
    end
    env.DarkwenFishCleanup = nil
end
env.DarkwenFishCleanup = cleanup

