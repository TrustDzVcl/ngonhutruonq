local function isSummon(obj)
    local owner = obj:FindFirstChild("Owner") or obj:FindFirstChild("Creator") or obj:FindFirstChild("Master")
    if owner and owner:IsA("ObjectValue") and owner.Value then
        return true
    end
    if obj:GetAttribute("Owner") or obj:GetAttribute("OwnerUserId") or obj:GetAttribute("Creator") then
        return true
    end
    local n = string.lower(obj.Name)
    for _, w in ipairs(SUMMON_WORDS) do
        if string.find(n, w, 1, true) then
            return true
        end
    end
    return false
end

local function scanEnemies(maxRange)
    local root = getRoot()
    if not root then
        return {}
    end
    local char = getChar()
    local list = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and eRoot and not isSummon(obj) then
                local d = (root.Position - eRoot.Position).Magnitude
                if d <= maxRange then
                    table.insert(list, {Model = obj, Root = eRoot, Hum = hum, Dist = d})
                end
            end
        end
    end
    table.sort(list, function(a, b)
        return a.Dist < b.Dist
    end)
    return list
end

