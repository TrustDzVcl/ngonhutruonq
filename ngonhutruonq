    end
end)

env.DarkwenCleanup = function()
    stopFarm()
    Features.Fly = false
    updateFly()
    Features.ESP_Enemies = false
    Features.ESP_Players = false
    Features.AutoChallenge = false
    Running.challenge = false
    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)
    table.clear(Pages)
    if ScreenGui then
        pcall(function()
            ScreenGui:Destroy()
        end)
    end
    env.DarkwenCleanup = nil
end