local function createStepper(parent, text, default, min, max, step, callback)
    local value = default
    step = step or 1
    local row = createRow(parent)
    new("TextLabel", {
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row
    })
    local minus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -100, 0.5, -13),
        BackgroundColor3 = C.Off,
        Text = "-",
        TextColor3 = C.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        BorderSizePixel = 0,
        Parent = row
    })
    corner(minus, 6)
    local valueLbl = new("TextLabel", {
        Size = UDim2.fromOffset(44, 26),
        Position = UDim2.new(1, -72, 0.5, -13),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = C.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        Parent = row
    })
    local plus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -30, 0.5, -13),
        BackgroundColor3 = C.Off,
        Text = "+",
        TextColor3 = C.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        BorderSizePixel = 0,
        Parent = row
    })
    corner(plus, 6)
    
    local function fmt(n)
        if n == math.floor(n) then
            return tostring(math.floor(n))
        end
        return string.format("%.2f", n)
    end
    
    local function apply(v)
        value = math.clamp(v, min, max)
        valueLbl.Text = fmt(value)
        if callback then
            task.spawn(callback, value)
        end
    end
    track(minus.MouseButton1Click:Connect(function()
        apply(value - step)
    end))
    track(plus.MouseButton1Click:Connect(function()
        apply(value + step)
    end))
end

