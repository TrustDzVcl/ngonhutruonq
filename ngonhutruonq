--// Darkwen | Heavyweight Fishing | Auto Green Zone (giữ thanh xanh)
local env = (getgenv and getgenv()) or _G
if env.DarkwenFishCleanup then pcall(env.DarkwenFishCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local State = {
    Enabled = true,
    HoldDir = 1,
    LastX = nil,
    Holding = false,
    Status = "Đang tìm thanh...",
}

local Connections = {}
local alive = true
local gui, btn

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local function isGreen(c)
    return c.G > 0.45 and (c.G - c.R) > 0.15 and (c.G - c.B) > 0.15
end

local function isInside(obj, ancestor)
    local p = obj
    while p do
        if p == ancestor then
            return true
        end
        p = p.Parent
    end
    return false
end

local barCache, zoneCache, markerCache = nil, nil, nil

local function validCache()
    return barCache and barCache.Parent and barCache.Visible
        and zoneCache and zoneCache.Parent and zoneCache.Visible
        and markerCache and markerCache.Parent and markerCache.Visible
end

local function findBar()
    if validCache() then
        return barCache, zoneCache, markerCache
    end
    barCache, zoneCache, markerCache = nil, nil, nil

    for _, bar in ipairs(PlayerGui:GetDescendants()) do
        if bar:IsA("GuiObject") and bar.Visible
            and bar.AbsoluteSize.X > 120
            and bar.AbsoluteSize.Y >= 6 and bar.AbsoluteSize.Y <= 80 then
            local bw = bar.AbsoluteSize.X
            local zone
            for _, c in ipairs(bar:GetDescendants()) do
                if c:IsA("Frame") and c.Visible and c.BackgroundTransparency < 0.5
                    and isGreen(c.BackgroundColor3)
                    and c.AbsoluteSize.X > bw * 0.05
                    and c.AbsoluteSize.X < bw * 0.95 then
                    zone = c
                    break
                end
            end
            if zone then
                local marker
                for _, c in ipairs(bar:GetDescendants()) do
                    if c:IsA("GuiObject") and c.Visible
                        and not isInside(c, zone)
                        and not isInside(zone, c)
                        and c.AbsoluteSize.X >= 2
                        and c.AbsoluteSize.X <= bw * 0.1
                        and c.AbsoluteSize.Y >= bar.AbsoluteSize.Y * 0.5 then
                        marker = c
                        break
                    end
                end
                if marker then
                    barCache, zoneCache, markerCache = bar, zone, marker
                    return bar, zone, marker
                end
            end
        end
    end
    return nil
end

local function setHold(on)
    if State.Holding == on then
        return
    end
    State.Holding = on
    local m = UIS:GetMouseLocation()
    pcall(function()
        VIM:SendMouseButtonEvent(m.X, m.Y, 0, on, game, 0)
    end)
end

local function setStatus(text)
    if State.Status ~= text then
        State.Status = text
        if btn then
            btn.Text = text
        end
    end
end

track(RunService.RenderStepped:Connect(function()
    if not alive then
        return
    end
    if not State.Enabled then
        setHold(false)
        setStatus("Giữ vùng xanh: OFF")
        return
    end

    local ok, err = pcall(function()
        local bar, zone, marker = findBar()
        if not bar then
            setHold(false)
            State.LastX = nil
            setStatus("Giữ vùng xanh: ON (chưa thấy thanh)")
            return
        end
        setStatus("Giữ vùng xanh: ON (đã bắt thanh)")

        local zl = zone.AbsolutePosition.X
        local zw = zone.AbsoluteSize.X
        local center = zl + zw / 2
        local mx = marker.AbsolutePosition.X + marker.AbsoluteSize.X / 2

        if State.LastX and State.Holding then
            local dx = mx - State.LastX
            if math.abs(dx) > 0.3 then
                State.HoldDir = dx > 0 and 1 or -1
            end
        end
        State.LastX = mx

        local diff = center - mx
        local deadband = zw * 0.08
        if math.abs(diff) <= deadband then
            setHold(false)
        else
            local needDir = diff > 0 and 1 or -1
            setHold(needDir == State.HoldDir)
        end
    end)
    if not ok then
        setHold(false)
        setStatus("Lỗi: " .. tostring(err):sub(1, 40))
    end
end))

gui = Instance.new("ScreenGui")
gui.Name = "DarkwenFish"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
local guiOk = false
if gethui then
    guiOk = pcall(function()
        gui.Parent = gethui()
    end)
end
if not guiOk or not gui.Parent then
    if not pcall(function()
        gui.Parent = CoreGui
    end) or not gui.Parent then
        gui.Parent = PlayerGui
    end
end

btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(230, 36)
btn.Position = UDim2.new(0.5, -115, 0, 10)
btn.BorderSizePixel = 0
btn.AutoButtonColor = false
btn.Font = Enum.Font.GothamBold
btn.TextSize = 13
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.BackgroundColor3 = Color3.fromRGB(50, 200, 90)
btn.Text = "Đang tìm thanh..."
btn.Parent = gui

track(btn.MouseButton1Click:Connect(function()
    State.Enabled = not State.Enabled
    btn.BackgroundColor3 = State.Enabled and Color3.fromRGB(50, 200, 90) or Color3.fromRGB(200, 60, 80)
    if not State.Enabled then
        setHold(false)
    end
end))

env.DarkwenFishCleanup = function()
    alive = false
    State.Enabled = false
    setHold(false)
    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)
    if gui then
        pcall(function()
            gui:Destroy()
        end)
    end
    env.DarkwenFishCleanup = nil
end