task.spawn(function()
    while alive do
        local skillCount = #skillButtons
        if not State.AutoFarm and not State.KillAura then
            statusLbl.Text = "Trạng thái: Đang tắt\nTìm thấy "..skillCount.." nút Skill"
        elseif State.KillAura then
            statusLbl.Text = "Kill Aura: Đang đánh " .. #auraTargets .. " quái\nTìm thấy "..skillCount.." nút Skill"
        elseif not currentTarget then
            statusLbl.Text = "Trạng thái: Không tìm thấy quái!\nTìm thấy "..skillCount.." nút Skill"
        else
            statusLbl.Text = "AutoFarm: Đang đánh " .. currentTarget.Parent.Name .. "\nTìm thấy "..skillCount.." nút Skill"
        end
        task.wait(0.2)
    end
end)

local function makeToggle(name, y, default, onChange)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(160, 36)
    btn.Position = UDim2.new(0.5, -80, 0, y)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = gui
    local value = default
    local function render()
        btn.Text = name .. ": " .. (value and "ON" or "OFF")
        btn.BackgroundColor3 = value and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    end
    render()
    track(btn.MouseButton1Click:Connect(function()
        value = not value; render(); onChange(value)
    end))
    return btn
end

makeToggle("AutoFarm", 10, false, function(v) State.AutoFarm = v end)
makeToggle("AutoSkill", 54, true, function(v) State.AutoSkill = v end)
makeToggle("Kill Aura", 98, false, function(v) State.KillAura = v end)

env.TrustCleanup = function()
    alive = false; State.AutoFarm = false; State.KillAura = false
    if originalGetTarget and type(MouseUtil) == "table" then MouseUtil.GetTarget = originalGetTarget end
    for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(Connections)
    if gui then gui:Destroy() end
    env.TrustCleanup = nil
end