local function makeToggle(name, y, default, onChange)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.fromOffset(160, 36)
    btn.Position = UDim2.new(0.5, -80, 0, y)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = gui

    local value = default
    local function render()
        btn.Text = name .. ": " .. (value and "ON" or "OFF")
        btn.BackgroundColor3 = value and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    end
    render()

    track(btn.MouseButton1Click:Connect(function()
        value = not value
        render()
        onChange(value)
    end))
    return btn
end

makeToggle("AutoFarm", 10, false, function(v)
    State.AutoFarm = v
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.PlatformStand = v
        end
        if root then
            root.Anchored = v
            root.CanCollide = not v
            if not v then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end)

makeToggle("AutoSkill", 54, true, function(v)
    State.AutoSkill = v
end)

if not originalGetTarget then
    warn("[TrustPremium] Khong hook duoc MouseUtil.GetTarget, skill co the van lech vi tri.")
end

env.TrustPremiumCleanup = function()
    alive = false
    State.AutoFarm = false
    if originalGetTarget and type(MouseUtil) == "table" then
        MouseUtil.GetTarget = originalGetTarget
    end
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum then hum.PlatformStand = false end
        if root then 
            root.Anchored = false
            root.CanCollide = true 
        end
    end

    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)
    if gui then
        gui:Destroy()
    end
    env.TrustPremiumCleanup = nil
end