local function nextOrder() order += 1 return order end
local function track(conn) table.insert(Connections, conn) return conn end

local function new(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do
        pcall(function() inst[k] = v end)
    end
    inst.Parent = parent
    return inst
end

local function corner(obj, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius), Parent = obj})
end

local function protectGui(gui)
    local ok = false
    if gethui then ok = pcall(function() gui.Parent = gethui() end) end
    if not ok or not gui.Parent then
        ok = pcall(function() gui.Parent = CoreGui end)
        if not ok or not gui.Parent then gui.Parent = PlayerGui end
    end
end

local function getMapFolder()
    for _, name in ipairs(MAP_FOLDER_NAMES) do
        local folder = workspace:FindFirstChild(name)
        if folder and #folder:GetChildren() > 0 then return folder end
    end
    return nil
end

local function refreshMaps()
    local list = {}
    local folder = getMapFolder()
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") or child:IsA("Folder") then
                table.insert(list, child.Name)
            end
        end
    end
    table.sort(list)
    if State.SelectedMap and not table.find(list, State.SelectedMap) then
        State.SelectedMap = nil
    end
    return list
end

local _targetRoot = nil
local _targetRefreshTime = 0
local TARGET_REFRESH = 0.15

local function getSearchRoot()
    if not State.SelectedMap then return workspace end
    local folder = getMapFolder()
    return folder and folder:FindFirstChild(State.SelectedMap) or nil
end

local function findClosestEnemy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local searchRoot = getSearchRoot()
    if not searchRoot then return nil end

    local closest, shortest = nil, math.huge
    local rootPos = root.Position

    for _, obj in ipairs(searchRoot:GetChildren()) do
        if obj:IsA("Model") and obj ~= char then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and enemyRoot 
               and not Players:GetPlayerFromCharacter(obj) then
                local dx = rootPos.X - enemyRoot.Position.X
                local dy = rootPos.Y - enemyRoot.Position.Y
                local dz = rootPos.Z - enemyRoot.Position.Z
                local d = dx*dx + dy*dy + dz*dz
                if d < shortest and d < 160000 then
                    shortest = d
                    closest = enemyRoot
                end
            end
        end
    end

    if not closest then
        local desc = searchRoot:GetDescendants()
        for i = 1, #desc do
            local obj = desc[i]
            if obj:IsA("Model") and obj ~= char then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hum and hum.Health > 0 and enemyRoot 
                   and not Players:GetPlayerFromCharacter(obj) then
                    local dx = rootPos.X - enemyRoot.Position.X
                    local dy = rootPos.Y - enemyRoot.Position.Y
                    local dz = rootPos.Z - enemyRoot.Position.Z
                    local d = dx*dx + dy*dy + dz*dz
                    if d < shortest and d < 160000 then
                        shortest = d
                        closest = enemyRoot
                    end
                end
            end
        end
    end

    return closest
end

local _equippedTool = nil
local function ensureTool(char, hum)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then _equippedTool = tool return tool end
    if _equippedTool and _equippedTool.Parent then return _equippedTool end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    tool = backpack and backpack:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() hum:EquipTool(tool) end)
        _equippedTool = tool
    end
    return tool
end

local function pressKey(key)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
end

local farmConn = nil

local function startFarm()
    if farmConn then farmConn:Disconnect() end

    local skillAccum = 0
    local lastSkillTime = 0

    farmConn = RunService.Heartbeat:Connect(function(dt)
        if not State.AutoFarm then return end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (hum and root and hum.Health > 0) then return end

        local now = tick()
        if now - _targetRefreshTime > TARGET_REFRESH then
            _targetRoot = findClosestEnemy()
            _targetRefreshTime = now
        end

        local target = _targetRoot
        if target and target.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            local targetPos = target.Position + Vector3.new(0, State.Distance, 0)
            root.CFrame = CFrame.new(targetPos, target.Position)

            local tool = ensureTool(char, hum)
            if tool then
                pcall(function() tool:Activate() end)
            end

            if State.SpamSkill then
                skillAccum += dt
                if skillAccum >= 0.25 then
                    skillAccum = 0
                    task.spawn(function()
                        for _, key in ipairs(SkillKeys) do
                            if not State.AutoFarm then break end
                            pressKey(key)
                            task.wait(0.05)
                        end
                    end)
                    lastSkillTime = now
                end
            end
        end
    end)
    track(farmConn)
end

local function stopFarm()
    if farmConn then
        farmConn:Disconnect()
        farmConn = nil
    end
    _targetRoot = nil
    _equippedTool = nil
end

local function makeDraggable(handle, target, onClick)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if endedConn then endedConn:Disconnect() end
                    if not moved and onClick then task.spawn(onClick) end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))
end

