local function serverHop()
    if not request then
        notify("Server", "Executor does not support request")
        return
    end
    local ok, res = pcall(request, {
        Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId),
        Method = "GET",
    })
    if not ok or not res or not res.Body then
        notify("Server", "Failed to fetch server list")
        return
    end
    local decoded, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not decoded or type(data) ~= "table" then
        notify("Server", "Invalid server data")
        return
    end
    local candidates = {}
    for _, s in ipairs(data.data or {}) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            table.insert(candidates, s.id)
        end
    end
    if #candidates == 0 then
        notify("Server", "No suitable server found")
        return
    end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, candidates[math.random(#candidates)], LocalPlayer)
end

