                local skip = plr == LocalPlayer
                    or not hum or not pRoot
                    or (State.HideTeammates and plr.Team ~= nil and plr.Team == LocalPlayer.Team)
                if not skip then
                    active[char] = true
                    local e = ensureESP(char, Color3.fromRGB(80, 200, 255))
                    local dist = root and math.floor((root.Position - pRoot.Position).Magnitude) or 0
                    e.Label.Text = string.format("%s [%dm] HP %d", plr.Name, dist, math.floor(hum.Health))
                end
            end
        end
        if State.ESPEnemies then
            for _, entry in ipairs(scanEnemies(State.ESPRange)) do
                active[entry.Model] = true
                local e = ensureESP(entry.Model, Color3.fromRGB(255, 150, 60))
                e.Label.Text = string.format("%s [%dm] HP %d", entry.Model.Name, math.floor(entry.Dist), math.floor(entry.Hum.Health))
            end
        end
        for model in pairs(espObjects) do
            if not active[model] or not model.Parent then
                clearESP(model)
            end
        end
        task.wait(0.5)
    end
end)

