--// Darkwen | Heavyweight Fishing | Auto Green Zone (giữ thanh xanh)
local env = (getgenv and getgenv()) or _G
if env.DarkwenFishCleanup then pcall(env.DarkwenFishCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local State = {
    Enabled = true,
    HoldDir = 1,
    LastHolding = false,
    LastX = nil,
    Holding = false,
}

local Connections = {}
local alive = true
local gui

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local function isGreen(c)
    return c.G > 0.5 and (c.G - c.R) > 0.2 and (c.G - c.B) > 0.2
end

local function isDescendantOf(obj, ancestor)
    local p = obj
    while p do
        if p == ancestor then
            return true
        end
        p = p.Parent
    end
    return false
end

--// Tìm thanh minigame: frame nằm ngang có vùng xanh và con trỏ
local barCache, zoneCache, markerCache = nil, nil, nil

local function findBar()
    if barCache and barCache.Parent and barCache.Visible then
        local zone = zoneCache
        local marker = markerCache
        if zone and zone.Parent and marker and marker.Parent and zone.Visible and marker.Visible then
            return barCache, zone, marker
        end
    end
    barCache, zoneCache, markerCache = nil, nil, nil

    for _, bar in ipairs(PlayerGui:GetDescendants()) do
        if bar:IsA("Frame") and bar.Visible
            and bar.AbsoluteSize.X > 150
            and bar.AbsoluteSize.Y > 6 and bar.AbsoluteSize.Y < 60 then
            local bw = bar.AbsoluteSize.X
            local zone
            for _, c in ipairs(bar:GetDescendants()) do
                if c:IsA("Frame") and c.Visible and c.BackgroundTransparency < 0.5
                    and isGreen(c.BackgroundColor3)
                    and c.AbsoluteSize.X > bw * 0.08
                    and c.AbsoluteSize.X < bw * 0.9 then
                    zone = c
                    break
                end
            end
            if zone then
                local marker
                for _, c in ipairs(bar:GetDescendants()) do
                    if c:IsGA and false then
                    end
                    if c:IsA("GuiObject") and c.Visible and c ~= zone
                        and not isDescendantOf(c, zone)
                        and not isDescendantOf(zone, c)
                        and c.AbsoluteSize.X >= 2
                        and c.AbsoluteSize.X <= bw * 0.08
                        and c.AbsoluteSize.Y >= bar.AbsoluteSize.Y * 0.5 then
                        marker = c
                        break
                    end
                end
                if marker then
                    barCache, zoneCache, markerCache = bar, zone, marker
                    return bar, zone, marker
                end
            end
        end
    end
    return nil
end

--// Điều khiển giữ chuột
local function setHold(on)
    if State.Holding == on then
        return
    end
    State.Holding = on
    local mouse = UIS:GetMouseLocation()
    pcall(function()
        VIM:SendMouseButtonEvent(mouse.X, mouse.Y, 0, on, game, 0)
    end)
end

track(RunService.RenderStepped:Connect(function()
    if not alive then
        return
    end
    if not State.Enabled then
        setHold(false)
        return
    end

    local bar, zone, marker = findBar()
    if not bar then
        setHold(false)
        State.LastX = nil
        return
    end

    local zl = zone.AbsolutePosition.X
    local zr = zl + zone.AbsoluteSize.X
    local center = (zl + zr) / 2
    local mx = marker.AbsolutePosition.X + marker.AbsoluteSize.X / 2

    --// Tự học hướng con trỏ khi đang giữ chuột
    if State.LastX and State.Holding then
        local dx = mx - State.LastX
        if math.abs(dx) > 0.3 then
            State.HoldDir = dx > 0 and 1 or -1
        end
    end
    State.LastX = mx

    --// Giữ khi con trỏ đang lệch về phía cần đẩy, nhả khi đã vượt qua tâm
    local deadband = zone.AbsoluteSize.X * 0.05
    local error = (center - mx)
    if math.abs(error) <= deadband then
        setHold(false)
    else
        local needDir = error > 0 and 1 or -1
        setHold(needDir == State.HoldDir)
    end
end))

--// Nút bật/tắt nhỏ, kéo thả được bằng cảm ứng và chuột
gui = Instance.new("ScreenGui")
gui.Name = "DarkwenFish"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
local guiOk = false
if gethui then
    guiOk = pcall(function()
        gui.Parent = gethui()
    end)
end
if not guiOk or not gui.Parent then
    if not pcall(function()
        gui.Parent = CoreGui
    end) or not gui.Parent then
        gui.Parent = PlayerGui
    end
end

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(150, 36)
btn.Position = UDim2.new(0.5, -75, 0, 10)
btn.BorderSizePixel = 0
btn.AutoButtonColor = false
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Parent = gui

local function render()
    btn.Text = "Giữ vùng xanh: " .. (State.Enabled and "ON" or "OFF")
    btn.BackgroundColor3 = State.Enabled and Color3.fromRGB(50, 200, 90) or Color3.fromRGB(200, 60, 80)
end
render()

track(btn.MouseButton1Click:Connect(function()
    State.Enabled = not State.Enabled
    render()
    if not State.Enabled then
        setHold(false)
    end
end))

--// Cleanup
env.DarkwenFishCleanup = function()
    alive = false
    State.Enabled = false
    setHold(false)
    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)
    if gui then
        pcall(function()
            gui:Destroy()
        end)
    end
    env.DarkwenFishCleanup = nil
end