local order = 0
local function nextOrder()
    order += 1
    return order
end

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local function new(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do
        pcall(function() inst[k] = v end)
    end
    inst.Parent = parent
    return inst
end

local function corner(obj, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius), Parent = obj})
end

local function protectGui(gui)
    local ok = false
    if gethui then
        ok = pcall(function() gui.Parent = gethui() end)
    end
    if not ok or not gui.Parent then
        ok = pcall(function() gui.Parent = CoreGui end)
        if not ok or not gui.Parent then
            gui.Parent = PlayerGui
        end
    end
end

local function ClickUIByText(textTarget, isExact)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    for _, v in ipairs(playerGui:GetDescendants()) do
        if v:IsA("TextButton") or v:IsA("ImageButton") then
            local text = ""
            if v:IsA("TextButton") then
                text = v.Text
            else
                local label = v:FindFirstChildWhichIsA("TextLabel")
                if label then text = label.Text end
            end
            
            local match = false
            if isExact then
                match = (text:lower() == textTarget:lower())
            else
                match = (text:lower():find(textTarget:lower()) ~= nil)
            end
            
            if match and v.Visible and v.AbsoluteSize.Magnitude > 0 then
                local pos = v.AbsolutePosition + (v.AbsoluteSize / 2)
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                end)
                return true
            end
        end
    end
    return false
end

local function getMapFolder()
    for _, name in ipairs(MAP_FOLDER_NAMES) do
        local folder = workspace:FindFirstChild(name)
        if folder and #folder:GetChildren() > 0 then
            return folder
        end
    end
    return nil
end

local function refreshMaps()
    local list = {}
    local folder = getMapFolder()
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") or child:IsA("Folder") then
                table.insert(list, child.Name)
            end
        end
    end
    table.sort(list)
    if State.SelectedMap and not table.find(list, State.SelectedMap) then
        State.SelectedMap = nil
    end
    return list
end

local function getSearchRoot()
    if not State.SelectedMap then
        return workspace
    end
    local folder = getMapFolder()
    return folder and folder:FindFirstChild(State.SelectedMap) or nil
end

local function GetClosestEnemy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local searchRoot = getSearchRoot()
    if not searchRoot then return nil end

    local closestEnemy = nil
    local shortestDistance = math.huge
    local rootPos = root.Position

    local children = searchRoot:GetChildren()
    for i = 1, #children do
        local obj = children[i]
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and enemyRoot then
                local d = (rootPos - enemyRoot.Position).Magnitude
                if d < shortestDistance and d < 400 then
                    shortestDistance = d
                    closestEnemy = enemyRoot
                end
            end
        end
    end

    if not closestEnemy then
        local desc = searchRoot:GetDescendants()
        for i = 1, #desc do
            local obj = desc[i]
            if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hum and hum.Health > 0 and enemyRoot then
                    local d = (rootPos - enemyRoot.Position).Magnitude
                    if d < shortestDistance and d < 400 then
                        shortestDistance = d
                        closestEnemy = enemyRoot
                    end
                end
            end
        end
    end

    return closestEnemy
end

local function spamSkillKeys()
    for _, key in ipairs(SkillKeys) do
        if not State.AutoFarm then break end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, key, false, game)
        end)
        task.wait(State.KeyDelay)
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
        task.wait(State.KeyDelay)
    end

    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
end

local function startFarm()
    if Running.farm then return end
    Running.farm = true

    task.spawn(function()
        RunService.Heartbeat:Connect(function()
            if not State.AutoFarm or not Running.farm then return end

            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local target = GetClosestEnemy()

            if root and target then
                root.Velocity = Vector3.new(0, 0, 0)
                local targetPos = target.Position + Vector3.new(0, State.HeightOffset, 0)
                root.CFrame = CFrame.new(targetPos, target.Position)
            end
        end)
    end)

    task.spawn(function()
        while State.AutoFarm and Running.farm do
            task.wait(State.SkillDelay)
            if State.AutoFarm and GetClosestEnemy() then
                spamSkillKeys()
            end
        end
        Running.farm = false
    end)
end

local function stopFarm()
    State.AutoFarm = false
    Running.farm = false
end

local function makeDraggable(handle, target, onClick)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if endedConn then endedConn:Disconnect() end
                    if not moved and onClick then task.spawn(onClick) end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))
end

