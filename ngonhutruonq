local function mountGui(g)
    if syn and syn.protect_gui then
        pcall(syn.protect_gui, g)
    end
    if gethui then
        local ok = pcall(function()
            g.Parent = gethui()
        end)
        if ok and g.Parent then
            return
        end
    end
    local ok2 = pcall(function()
        g.Parent = CoreGui
    end)
    if ok2 and g.Parent then
        return
    end
    g.Parent = PlayerGui
end

