local env = (getgenv and getgenv()) or _G
if env.TrustPremiumCleanup then pcall(env.TrustPremiumCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer

local CoreGui
pcall(function() CoreGui = game:GetService("CoreGui") end)

local VirtualInputManager
pcall(function() VirtualInputManager = game:GetService("VirtualInputManager") end)

local CONFIG = {
    HeightOffset = 7.5,
    MaxRange = 400,
    SkillKeys = {
        Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
    },
    SkillInterval = 0.25,
    KeyHold = 0.05,
    TargetRefresh = 0.2,
}

local State = {
    AutoFarm = false,
    AutoSkill = true,
    BoostFPS = true,
}

local Connections = {}
local alive = true
local currentTarget = nil

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local gui = Instance.new("ScreenGui")
gui.Name = "TrustPremium"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999

local parented = false
if gethui then
    parented = pcall(function() gui.Parent = gethui() end)
end
if not parented and CoreGui then
    parented = pcall(function() gui.Parent = CoreGui end)
end
if not parented then
    pcall(function() gui.Parent = LocalPlayer:WaitForChild("PlayerGui", 5) end)
end

local function makeToggle(name, y, default, onChange)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.fromOffset(160, 36)
    btn.Position = UDim2.new(0.5, -80, 0, y)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = gui

    local value = default
    local function render()
        btn.Text = name .. ": " .. (value and "ON" or "OFF")
        btn.BackgroundColor3 = value and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    end
    render()

    track(btn.MouseButton1Click:Connect(function()
        value = not value
        render()
        onChange(value)
    end))
    return btn
end

makeToggle("AutoFarm", 10, false, function(v) State.AutoFarm = v end)
makeToggle("AutoSkill", 54, true, function(v) State.AutoSkill = v end)
makeToggle("Boost FPS", 98, true, function(v)
    State.BoostFPS = v
    if v then applyBoostFPS() end
end)

local function cleanEffect(obj)
    if not State.BoostFPS then return end
    pcall(function()
        if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            obj.Enabled = false
            if obj:IsA("ParticleEmitter") then obj.Rate = 0 end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("Trail") then
            obj.Enabled = false
        end
    end)
end

local function applyBoostFPS()
    if not State.BoostFPS then return end
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Sky") then
                v.StarCount = 0
                v.Clouds = false
            elseif v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
                v.Enabled = false
            end
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            cleanEffect(v)
        end
    end)
end

if State.BoostFPS then
    applyBoostFPS()
    track(workspace.DescendantAdded:Connect(cleanEffect))
end

local function pressSkill(key)
    pcall(function()
        if keypress then keypress(key) end
    end)
    if VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(CONFIG.KeyHold)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
    end
end

local MouseUtil
pcall(function()
    local utils = ReplicatedStorage:FindFirstChild("Utilities")
    if utils then
        MouseUtil = require(utils:WaitForChild("MouseUtil", 5))
    end
end)

local originalGetTarget
if type(MouseUtil) == "table" and type(MouseUtil.GetTarget) == "function" then
    originalGetTarget = MouseUtil.GetTarget
    MouseUtil.GetTarget = function(...)
        if State.AutoFarm and currentTarget and currentTarget.Parent then
            return currentTarget.Position
        end
        return originalGetTarget(...)
    end
end

local function getClosestEnemy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, bestDist = nil, CONFIG.MaxRange
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and eRoot then
                local d = (root.Position - eRoot.Position).Magnitude
                if d < bestDist then best, bestDist = eRoot, d end
            end
        elseif obj:IsA("Folder") then
            for _, subObj in ipairs(obj:GetChildren()) do
                if subObj:IsA("Model") and not Players:GetPlayerFromCharacter(subObj) then
                    local hum = subObj:FindFirstChildOfClass("Humanoid")
                    local eRoot = subObj:FindFirstChild("HumanoidRootPart") or subObj:FindFirstChild("Torso")
                    if hum and hum.Health > 0 and eRoot then
                        local d = (root.Position - eRoot.Position).Magnitude
                        if d < bestDist then best, bestDist = eRoot, d end
                    end
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while alive do
        pcall(function()
            if State.AutoFarm then
                currentTarget = getClosestEnemy()
            else
                currentTarget = nil
            end
        end)
        task.wait(CONFIG.TargetRefresh)
    end
end)

track(RunService.Heartbeat:Connect(function()
    if not (alive and State.AutoFarm) then return end
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local target = currentTarget
        if root and target and target.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(target.Position + Vector3.new(0, CONFIG.HeightOffset, 0), target.Position)
        end
    end)
end))

task.spawn(function()
    while alive do
        pcall(function()
            if State.AutoFarm and State.AutoSkill and currentTarget and currentTarget.Parent then
                for _, key in ipairs(CONFIG.SkillKeys) do
                    if not (alive and State.AutoFarm and State.AutoSkill) then break end
                    pressSkill(key)
                    task.wait(0.05)
                end
            end
        end)
        task.wait(CONFIG.SkillInterval)
    end
end)

env.TrustPremiumCleanup = function()
    alive = false
    State.AutoFarm = false
    if originalGetTarget and type(MouseUtil) == "table" then
        MouseUtil.GetTarget = originalGetTarget
    end
    for _, conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Connections)
    if gui then gui:Destroy() end
    env.TrustPremiumCleanup = nil
end