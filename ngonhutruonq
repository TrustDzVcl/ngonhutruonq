local function createStepper(parent, text, default, min, max, step, callback)
    local value = default
    step = step or 1
    local row = createRow(parent)
    new("TextLabel", {
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local minus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -100, 0.5, -13),
        BackgroundColor3 = C.Off,
        Text = "-",
        TextColor3 = C.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        BorderSizePixel = 0,
        Parent = row,
    })
    local valueLbl = new("TextLabel", {
        Size = UDim2.fromOffset(44, 26),
        Position = UDim2.new(1, -72, 0.5, -13),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = C.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Parent = row,
    })
    local plus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -30, 0.5, -13),
        BackgroundColor3 = C.Off,
        Text = "+",
        TextColor3 = C.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(minus, 6)
    corner(plus, 6)
    local function fmt(n)
        if n == math.floor(n) then return tostring(math.floor(n)) end
        return string.format("%.2f", n)
    end
    local function apply(v)
        value = math.clamp(v, min, max)
        valueLbl.Text = fmt(value)
        if callback then task.spawn(callback, value) end
    end
    track(minus.MouseButton1Click:Connect(function() apply(value - step) end))
    track(plus.MouseButton1Click:Connect(function() apply(value + step) end))
end

local function createDropdown(parent, text, getOptions, onSelect)
    local header = createRow(parent, 38)
    local headerBtn = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = header,
    })
    new("TextLabel", {
        Size = UDim2.new(0.5, -12, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })
    local current = new("TextLabel", {
        Size = UDim2.new(0.5, -30, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = State.SelectedMap or ALL_LABEL,
        TextColor3 = C.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = header,
    })
    local listFrame = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 120),
        BackgroundColor3 = C.Panel,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
    corner(listFrame, 8)
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = listFrame,
    })

    local function rebuild()
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local options = {ALL_LABEL}
        for _, name in ipairs(getOptions()) do
            table.insert(options, name)
        end
        for i, name in ipairs(options) do
            local item = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundColor3 = C.Panel,
                Text = name,
                TextColor3 = C.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                BorderSizePixel = 0,
                LayoutOrder = i,
                Parent = listFrame,
            })
            track(item.MouseButton1Click:Connect(function()
                local value = (name ~= ALL_LABEL) and name or nil
                State.SelectedMap = value
                current.Text = name
                listFrame.Visible = false
                if onSelect then task.spawn(onSelect, value) end
            end))
        end
    end

    track(headerBtn.MouseButton1Click:Connect(function()
        if not listFrame.Visible then rebuild() end
        listFrame.Visible = not listFrame.Visible
    end))
end

local function createTab(name)
    local tabBar = ScreenGui.Main:FindFirstChild("TabBar")
    local btn = new("TextButton", {
        Size = UDim2.new(0, 80, 1, 0),
        BackgroundColor3 = C.Panel,
        Text = name,
        TextColor3 = C.Sub,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        BorderSizePixel = 0,
        Parent = tabBar,
    })
    corner(btn, 6)
    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -88),
        Position = UDim2.fromOffset(10, 80),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = ScreenGui.Main,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })
    local function activate()
        for _, p in ipairs(Pages) do
            p.Page.Visible = false
            p.Btn.TextColor3 = C.Sub
            p.Btn.BackgroundColor3 = C.Panel
        end
        page.Visible = true
        btn.TextColor3 = C.Text
        btn.BackgroundColor3 = C.Accent
    end
    track(btn.MouseButton1Click:Connect(activate))
    table.insert(Pages, {Btn = btn, Page = page})
    if #Pages == 1 then activate() end
    return page
end

