local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local function new(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do
        pcall(function() inst[k] = v end)
    end
    inst.Parent = parent
    return inst
end

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
    return c
end

local function getMapFolder()
    for _, name in ipairs(MAP_FOLDER_NAMES) do
        local folder = workspace:FindFirstChild(name)
        if folder and #folder:GetChildren() > 0 then return folder end
    end
    return nil
end

local function GetClosestEnemy()
    local currentMap = LocalPlayer:GetAttribute("CurrentMap")
    if currentMap == "Lobby" or not currentMap then return nil end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local searchRoot = workspace
    if State.SelectedMap then
        local folder = getMapFolder()
        searchRoot = folder and folder:FindFirstChild(State.SelectedMap) or nil
    end
    if not searchRoot then return nil end

    local closestEnemy = nil
    local shortestDistance = math.huge
    local rootPos = root.Position

    local children = searchRoot:GetChildren()
    for i = 1, #children do
        local obj = children[i]
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and enemyRoot then
                local d = (rootPos - enemyRoot.Position).Magnitude
                if d < shortestDistance and d < 400 then
                    shortestDistance = d
                    closestEnemy = enemyRoot
                end
            end
        end
    end

    if not closestEnemy then
        local desc = searchRoot:GetDescendants()
        for i = 1, #desc do
            local obj = desc[i]
            if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hum and hum.Health > 0 and enemyRoot then
                    local d = (rootPos - enemyRoot.Position).Magnitude
                    if d < shortestDistance and d < 400 then
                        shortestDistance = d
                        closestEnemy = enemyRoot
                    end
                end
            end
        end
    end
    return closestEnemy
end

local function startFarm()
    if Running.farm then return end
    Running.farm = true

    task.spawn(function()
        RunService.Heartbeat:Connect(function()
            if not State.AutoFarm or not Running.farm or State.Fly then return end
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local target = GetClosestEnemy()
            if root and target then
                root.Velocity = Vector3.new(0, 0, 0)
                local targetPos = target.Position + Vector3.new(0, State.HeightOffset, 0)
                root.CFrame = CFrame.new(targetPos, target.Position)
            end
        end)
    end)

    task.spawn(function()
        while State.AutoFarm and Running.farm do
            task.wait(State.SkillDelay)
            local target = GetClosestEnemy()
            if State.AutoFarm and target then
                pcall(function()
                    if RemoteBank then
                        if State.Punch then RemoteBank.PunchRemote:Fire() end
                        if State.Skill then RemoteBank.CastPower:Fire({ targetPosition = target.Position }) end
                    end
                end)
            end
        end
        Running.farm = false
    end)
end

local function stopFarm()
    State.AutoFarm = false
    Running.farm = false
end

local FlyState = { Conn = nil, BV = nil, BG = nil }
local function updateFly()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if State.Fly and hrp then
        if not FlyState.BV then
            FlyState.BV = Instance.new("BodyVelocity", hrp)
            FlyState.BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            FlyState.BV.Velocity = Vector3.zero
            FlyState.BG = Instance.new("BodyGyro", hrp)
            FlyState.BG.P = 9e4
            FlyState.BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            FlyState.BG.CFrame = hrp.CFrame
        end
        if not FlyState.Conn then
            FlyState.Conn = RunService.RenderStepped:Connect(function()
                if not State.Fly or not hrp or not FlyState.BV then return end
                local camera = workspace.CurrentCamera
                local moveDir = Vector3.zero
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                
                if moveDir.Magnitude > 0 then
                    FlyState.BV.Velocity = moveDir.Unit * State.FlySpeed
                    FlyState.BG.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + moveDir.Unit)
                else
                    FlyState.BV.Velocity = Vector3.zero
                    FlyState.BG.CFrame = camera.CFrame
                end
            end)
        end
    else
        if FlyState.Conn then FlyState.Conn:Disconnect() FlyState.Conn = nil end
        if FlyState.BV then FlyState.BV:Destroy() FlyState.BV = nil end
        if FlyState.BG then FlyState.BG:Destroy() FlyState.BG = nil end
    end
end

local espRunning = false
local function updateESP()
    if not State.ESP_Enemies and not State.ESP_Players then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v.Name == "TrustESP" then v:Destroy() end
        end
        return
    end
    if espRunning then return end
    espRunning = true
    task.spawn(function()
        while State.ESP_Enemies or State.ESP_Players do
            task.wait(1)
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v ~= LocalPlayer.Character then
                    local isPlayer = Players:GetPlayerFromCharacter(v) ~= nil
                    local shouldESP = (isPlayer and State.ESP_Players) or (not isPlayer and State.ESP_Enemies)
                    if shouldESP then
                        if not v:FindFirstChild("TrustESP") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "TrustESP"
                            hl.FillColor = isPlayer and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(255, 50, 50)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.5
                            hl.Parent = v
                        end
                    else
                        local hl = v:FindFirstChild("TrustESP")
                        if hl then hl:Destroy() end
                    end
                end
            end
        end
        espRunning = false
    end)
end

local function ClickUIByText(textTarget, isExact)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, v in ipairs(pg:GetDescendants()) do
        if v:IsA("TextButton") or v:IsA("ImageButton") then
            local text = v:IsA("TextButton") and v.Text or (v:FindFirstChildWhichIsA("TextLabel") and v:FindFirstChildWhichIsA("TextLabel").Text or "")
            local match = false
            if isExact then match = (text:lower() == textTarget:lower())
            else match = (text:lower():find(textTarget:lower()) ~= nil) end
            
            if match and v.Visible and v.AbsoluteSize.Magnitude > 0 then
                local pos = v.AbsolutePosition + (v.AbsoluteSize / 2)
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                end)
                return true
            end
        end
    end
    return false
end

local function startAutoChallenge()
    if Running.challenge then return end
    Running.challenge = true
    task.spawn(function()
        while State.AutoChallenge and Running.challenge do
            ClickUIByText("Challenges")
            task.wait(1.5)
            ClickUIByText("Daily Challenge")
            task.wait(1.5)
            local clickedPlay = ClickUIByText("Select") or ClickUIByText("V", true)
            if clickedPlay then task.wait(10) else task.wait(3) end
        end
        Running.challenge = false
    end)
end

local function makeDraggable(handle, target, onClick)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if endedConn then endedConn:Disconnect() end
                    if not moved and onClick then task.spawn(onClick) end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end))
end

