    local switchBg = new("Frame", {Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -56, 0.5, -11), BackgroundColor3 = default and C.Accent or C.Off, BorderSizePixel = 0, Parent = row})
    corner(switchBg, 11)
    local knob = new("Frame", {Size = UDim2.fromOffset(18, 18), Position = default and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1, 1, 1), Parent = switchBg})
    corner(knob, 9)
    local clickBtn = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = row})
    local state = default
    track(clickBtn.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = state and C.Accent or C.Off}):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {Position = state and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2)}):Play()
        if callback then callback(state) end
    end))
end

