local env = (getgenv and getgenv()) or _G
if env.TrustCleanup then pcall(env.TrustCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local CONFIG = {
    HeightOffset = 3,
    MaxRange = 400,
    KillAuraRange = 60,
    SkillKeys = {
        Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
    },
    SkillInterval = 0.2,
    TargetRefresh = 0.1,
}

local State = {
    AutoFarm = false,
    AutoSkill = true,
    KillAura = false,
}

local Connections = {}
local alive = true
local currentTarget = nil
local auraTargets = {}
local skillButtons = {}

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

-- TỰ ĐỘNG TÌM CÁC NÚT SKILL TRÊN MÀN HÌNH
local function updateSkillButtons()
    skillButtons = {}
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return end
    
    for _, gui in ipairs(pGui:GetDescendants()) do
        if (gui:IsA("ImageButton") or gui:IsA("TextButton")) and gui.Visible then
            local name = string.lower(gui.Name)
            if name == "1" or name == "2" or name == "3" or name == "4" or name == "5" 
               or string.find(name, "skill") or string.find(name, "attack") then
                table.insert(skillButtons, gui)
            end
        end
    end
end

task.spawn(function()
    while alive do
        updateSkillButtons()
        task.wait(2)
    end
end)

-- HÀM BẤM SKILL (3 TẦNG)
local function pressSkill(key, index)
    if keypress then pcall(keypress, 0.05) end
    
    local btn = skillButtons[index]
    if btn then
        pcall(function() btn:Activate() end)
        
        pcall(function()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            if VirtualInputManager then
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
            end
        end)
        
        if VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
            end)
        end
    else
        if VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
            end)
        end
    end
end

local MouseUtil
pcall(function()
    local utils = ReplicatedStorage:FindFirstChild("Utilities")
    if utils then
        MouseUtil = require(utils:WaitForChild("MouseUtil", 5))
    end
end)

local originalGetTarget
if type(MouseUtil) == "table" and type(MouseUtil.GetTarget) == "function" then
    originalGetTarget = MouseUtil.GetTarget
    MouseUtil.GetTarget = function(...)
        if (State.AutoFarm or State.KillAura) and currentTarget and currentTarget.Parent then
            return currentTarget.Position
        end
        return originalGetTarget(...)
    end
end

local function getAllEnemiesInRange(range)
    local list = {}
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return list end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and eRoot then
                local d = (root.Position - eRoot.Position).Magnitude
                if d <= range then
                    table.insert(list, eRoot)
                end
            end
        end
    end
    return list
end

task.spawn(function()
    while alive do
        if State.AutoFarm then
            local list = getAllEnemiesInRange(CONFIG.MaxRange)
            table.sort(list, function(a, b)
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return false end
                return (root.Position - a.Position).Magnitude < (root.Position - b.Position).Magnitude
            end)
            currentTarget = list[1]
        elseif State.KillAura then
            auraTargets = getAllEnemiesInRange(CONFIG.KillAuraRange)
            if #auraTargets > 0 then
                currentTarget = auraTargets[1]
            else
                currentTarget = nil
            end
        else
            currentTarget = nil
            auraTargets = {}
        end
        task.wait(CONFIG.TargetRefresh)
    end
end)

track(RunService.Heartbeat:Connect(function()
    if not alive or not State.AutoFarm then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local target = currentTarget
    
    if root and target and target.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        local targetPos = target.Position
        local myPos = targetPos + Vector3.new(0, CONFIG.HeightOffset, 0)
        root.CFrame = CFrame.new(myPos, targetPos) * CFrame.new(0, 0, 2)
    end
end))

task.spawn(function()
    while alive do
        if State.AutoSkill then
            if State.KillAura then
                for _, t in ipairs(auraTargets) do
                    if not (alive and State.KillAura and State.AutoSkill) then break end
                    currentTarget = t
                    for i, key in ipairs(CONFIG.SkillKeys) do
                        pressSkill(key, i)
                        task.wait(0.02)
                    end
                end
            elseif State.AutoFarm and currentTarget and currentTarget.Parent then
                for i, key in ipairs(CONFIG.SkillKeys) do
                    if not (alive and State.AutoFarm and State.AutoSkill) then break end
                    pressSkill(key, i)
                    task.wait(0.02)
                end
            end
        end
        task.wait(CONFIG.SkillInterval)
    end
end)

