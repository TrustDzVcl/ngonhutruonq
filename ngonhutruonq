-- Bảng Debug Trạng Thái
local statusLbl = Instance.new("TextLabel")
statusLbl.Size = UDim2.fromOffset(200, 20)
statusLbl.Position = UDim2.new(0.5, -100, 0, 180)
statusLbl.BackgroundTransparency = 1
statusLbl.TextColor3 = Color3.fromRGB(255, 200, 50)
statusLbl.Font = Enum.Font.SourceSansBold
statusLbl.TextSize = 14
statusLbl.Text = "Trạng thái: Chờ lệnh..."
statusLbl.Parent = gui

task.spawn(function()
    while alive do
        if not State.AutoFarm then
            statusLbl.Text = "Trạng thái: Đang tắt AutoFarm"
        elseif isDodging then
            statusLbl.Text = "Trạng thái: ĐANG NÉ CHIÊU..."
        elseif not currentTarget then
            statusLbl.Text = "Trạng thái: Không tìm thấy quái!"
        else
            statusLbl.Text = "Trạng thái: Đang đánh " .. currentTarget.Parent.Name
        end
        task.wait(0.2)
    end
end)

local function makeToggle(name, y, default, onChange)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(160, 36)
    btn.Position = UDim2.new(0.5, -80, 0, y)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = gui
    local value = default
    local function render()
        btn.Text = name .. ": " .. (value and "ON" or "OFF")
        btn.BackgroundColor3 = value and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    end
    render()
    track(btn.MouseButton1Click:Connect(function()
        value = not value; render(); onChange(value)
    end))
    return btn
end

local function makeButton(text, y, color, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(160, 36)
    btn.Position = UDim2.new(0.5, -80, 0, y)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.Parent = gui
    track(btn.MouseButton1Click:Connect(onClick))
    return btn
end

makeToggle("AutoFarm", 10, false, function(v) State.AutoFarm = v end)
makeToggle("AutoSkill", 54, true, function(v) State.AutoSkill = v end)
makeToggle("Né chiêu", 98, true, function(v) State.Dodge = v end)

makeButton("Mục tiêu: " .. State.TargetMode, 142, Color3.fromRGB(150, 50, 200), function()
    currentModeIndex = currentModeIndex + 1
    if currentModeIndex > #TargetModes then currentModeIndex = 1 end
    State.TargetMode = TargetModes[currentModeIndex]
    getgenv().TrustGUI_TargetBtn.Text = "Mục tiêu: " .. State.TargetMode
end).Name = "TrustGUI_TargetBtn"

env.TrustCleanup = function()
    alive = false; State.AutoFarm = false
    if originalGetTarget and type(MouseUtil) == "table" then MouseUtil.GetTarget = originalGetTarget end
    for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(Connections)
    if gui then gui:Destroy() end
    env.TrustCleanup = nil
end