local function createTab(name)
    local tabBar = ScreenGui.Main:FindFirstChild("TabBar")
    local btn = new("TextButton", {
        Size = UDim2.new(0, 70, 1, 0), BackgroundColor3 = Color3.fromRGB(28, 28, 35),
        Text = name, TextColor3 = Color3.fromRGB(150, 150, 165), Font = Enum.Font.GothamBold,
        TextSize = 12, BorderSizePixel = 0, Parent = tabBar
    })
    corner(btn, 6)
    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -88), Position = UDim2.fromOffset(10, 80),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, Parent = ScreenGui.Main
    })
    new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
    
    local function activate()
        for _, p in ipairs(Pages) do
            p.Page.Visible = false
            p.Btn.TextColor3 = Color3.fromRGB(150, 150, 165)
            p.Btn.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
        end
        page.Visible = true
        btn.TextColor3 = Color3.new(1,1,1)
        btn.BackgroundColor3 = Color3.fromRGB(130, 90, 255)
    end
    track(btn.MouseButton1Click:Connect(activate))
    table.insert(Pages, {Btn = btn, Page = page})
    if #Pages == 1 then activate() end
    return page
end

