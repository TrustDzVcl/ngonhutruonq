local function createStepper(parent, text, default, min, max, step, callback)
    local value = default
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Color3.fromRGB(28, 28, 35),
        BorderSizePixel = 0, Parent = parent
    })
    corner(row, 8)
    new("TextLabel", {
        Size = UDim2.new(1, -120, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(240, 240, 245),
        Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row
    })
    local minus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26), Position = UDim2.new(1, -100, 0.5, -13),
        BackgroundColor3 = Color3.fromRGB(45, 45, 55), Text = "-", TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, Parent = row
    })
    corner(minus, 6)
    local valueLbl = new("TextLabel", {
        Size = UDim2.fromOffset(44, 26), Position = UDim2.new(1, -72, 0.5, -13),
        BackgroundTransparency = 1, Text = tostring(value), TextColor3 = Color3.fromRGB(130, 90, 255),
        Font = Enum.Font.GothamBold, TextSize = 13, Parent = row
    })
    local plus = new("TextButton", {
        Size = UDim2.fromOffset(28, 26), Position = UDim2.new(1, -30, 0.5, -13),
        BackgroundColor3 = Color3.fromRGB(45, 45, 55), Text = "+", TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, Parent = row
    })
    corner(plus, 6)
    
    local function fmt(n)
        if n == math.floor(n) then return tostring(math.floor(n)) end
        return string.format("%.2f", n)
    end
    local function apply(v)
        value = math.clamp(v, min, max)
        valueLbl.Text = fmt(value)
        if callback then task.spawn(callback, value) end
    end
    track(minus.MouseButton1Click:Connect(function() apply(value - step) end))
    track(plus.MouseButton1Click:Connect(function() apply(value + step) end))
end

